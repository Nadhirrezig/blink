# Blink User Database Configuration
# Copy this file to .env and fill in your actual values

# Environment
NODE_ENV=development

# Database Configuration (Production PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blink_user_db
DB_USER=blink_user
DB_PASSWORD=your_secure_password_here

# Database Configuration (Staging PostgreSQL)
STAGING_DB_HOST=staging-db.example.com
STAGING_DB_PORT=5432
STAGING_DB_NAME=blink_user_db_staging
STAGING_DB_USER=blink_staging_user
STAGING_DB_PASSWORD=your_staging_password_here

# Security
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
SESSION_SECRET=your_session_secret_here_also_long_and_random
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Email Configuration (for verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@blink.com
FROM_NAME=Blink Team

# OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Application Settings
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_TIMEOUT=86400000
REMEMBER_ME_TIMEOUT=2592000000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/blink.log
